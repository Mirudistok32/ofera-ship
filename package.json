{
  "name": "ofera",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Офферомания: web на React и api на Express. Практика «Офферомания едет в прод»",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "postinstall": "npm ci --prefix api && npm ci --prefix web",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --prefix web",
    "typecheck": "npm run typecheck --prefix web",
    "reset": "npm run reset --prefix api",
    "test": "npm test --prefix api",
    "secrets:init": "node scripts/secrets.mjs init",
    "secrets:rotate": "node scripts/secrets.mjs rotate",
    "secrets:scan": "node scripts/secrets.mjs scan",
    "secrets:hook": "git config core.hooksPath .githooks"
  }
}
